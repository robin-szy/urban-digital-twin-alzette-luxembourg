temp/

# 3D water surface inputs (downloaded, not versioned)
data/raw/River_kilometers/
EDDIE/eddie_antarctica/data/terrain/
data/raw/Buildings/
data/raw/Flood_hazard/
data/raw/Flood_hazard/HWGK2021_HQext/
# LiDAR terrain tiles and geoid grid (scripts/build_lidar_terrain.sh)
EDDIE/eddie_antarctica/data/terrain/lidar_egm2008/
data/raw/Communes/
# Relative Elevation Model cache (eddie_water_level.rem), rebuilt when the DEM changes
EDDIE/eddie_antarctica/data/rem/

# Local duplicates of geodata that main already tracks through Git LFS
# (see .../geo/hwgk2021-hq100/). Kept out of git as raw blobs; the
# containers read them from disk through bind mounts.
EDDIE/eddie_antarctica/src/static/geo/*.gpkg
EDDIE/eddie_antarctica/src/static/geo/HWGK2021_HQ100/

# Raw inputs of eddie_base_data, placed by hand on each host
EDDIE/eddie_antarctica/src/static/geo/BU.Building.*
EDDIE/eddie_antarctica/src/static/geo/LIMADM_COMMUNES.*
EDDIE/eddie_antarctica/src/static/geo/rnpp_population_per_municipality.csv
EDDIE/eddie_antarctica/src/static/geo/copy_of_global_flood_depth-damage_functions__*.xlsx
EDDIE/eddie_antarctica/src/static/geo/provisionally_classified_buildings.csv
EDDIE/eddie_antarctica/src/static/geo/building_jrc_osm_classification.csv
EDDIE/eddie_antarctica/src/static/geo/classification_review_decisions.json
EDDIE/eddie_antarctica/src/static/geo/target_manifest.json

# Files belonging to the vendored EDDIE clone's own repository
EDDIE/eddie_antarctica/.gitmodules
EDDIE/eddie_antarctica/pull_request_template.md
